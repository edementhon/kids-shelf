# Pinned versions and checksums for the helpers spike build (ffmpeg/ffprobe + qjs).
# Sourced by build.sh. Downloads live under $BUILD_ROOT/downloads.
# Checksum provenance (recorded 2026-10-26):
#   ZIG_SHA256        published by ziglang.org in download/index.json (verified before pinning).
#   NASM_SHA256       nasm.us publishes no checksums; computed from the official nasm.us tarball.
#   FFMPEG_SHA256     ffmpeg.org publishes a GPG signature (FFMPEG_ASC_URL) but no sha256;
#                     computed from the official ffmpeg.org tarball.
#   QJS_SHA256        GitHub tag tarballs are immutable; computed from the official v0.17.0 tarball.
#   SAMPLE_SHA256     computed from the referenced W3C-hosted public-domain clip.

# Cross C toolchain
ZIG_VERSION=0.17.0
ZIG_URL=https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz
ZIG_SHA256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026

NASM_VERSION=3.02
NASM_URL=https://www.nasm.us/pub/nasm/releasebuilds/3.02/nasm-3.02.tar.xz
NASM_SHA256=87336eba53b4acfe917424ab5d500d2b0054d9f5148d35c2273ccf2cfb712f0d

# Components
X264_REPO=https://code.videolan.org/videolan/x264
X264_BRANCH=stable
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_ASC_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc

QJS_VERSION=0.17.0
QJS_URL=https://github.com/quickjs-ng/quickjs/archive/refs/tags/v0.17.0.tar.gz
QJS_SHA256=559bc4c420475e55c7ab4510adbc562f55d7524d75e8e89d79ce4bb02f5687d9

# Public-domain test clip (Sintel trailer, Blender Foundation, CC BY 3.0)
SAMPLE_URL=https://media.w3.org/2010/05/sintel/trailer.mp4
SAMPLE_SHA256=b670602fa00934ca27c4351bb0efe7ea7a07fae57284e44226025eeed7c51254
# ---- kiwix-serve stack (D4 2026-10-27; ZIM libraries served by kiwix-serve) --
# Dependency tree and versions follow kiwix/kiwix-build (kiwixbuild/dependencies/
# *.py, main @ 2026-10-27): kiwix-tools 3.8.2 needs libkiwix >=14.2 <15 and
# libzim >=9 <10; the rest match kiwix-build's pins.  All built static from
# source (except mustache.hpp, which is header-only); xapian-core 1.4.23
# autotools replaces kiwix-build's openzim/xapian-meson fork because the
# autotools build cross-compiles to mingw (and the fork's meson.build uses
# build_machine where host_machine is meant, which breaks Linux-hosted cross).
# Checksum provenance:
#   * where kiwix-build mirrors an official tarball (icu, xz/liblzma, curl,
#     libmicrohttpd, docopt.cpp, mustache, xapian-core) we fetch the official
#     original (unicode-org GitHub, tukaani.org, curl.se, ftp.gnu.org, GitHub,
#     dev.kiwix.org) and verify the SHA-256s match kiwix-build's pins
#     byte-for-byte.
#   * wrapdb meson patches (zlib, liblzma, docopt.cpp): wrapdb.mesonbuild.com
#     get_patch zips, SHA-256s match kiwix-build's pins.
#   * github tag tarballs (zstd, pugixml, zlib, libzim, libkiwix, kiwix-tools)
#     are immutable; SHA-256 computed from the downloaded archive.
#   * MESON_SHA256 / NINJA_SHA256 are the digests GitHub publishes on the
#     release assets.
#   * kiwix-build patch files are fixed blobs fetched from kiwix/kiwix-build
#     and pinned by SHA-256.
KIWIX_TOOLS_VERSION=3.8.2
KIWIX_TOOLS_URL=https://github.com/kiwix/kiwix-tools/archive/3.8.2.tar.gz
KIWIX_TOOLS_SHA256=7148522730a66cffb58a3b3674c6cbac548a1f95fd08c5f330565aad70c14d14

LIBKIWIX_VERSION=14.2.1
